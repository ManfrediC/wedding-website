  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/montserrat": "^5.2.8",
    "astro": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.59.1",
    "typescript": "latest"
