# Copy to .dev.vars or env/website_pw.env for local testing.
# Do not commit real secrets.

WEBSITE_PW=replace-with-local-site-password
WEDDING_AUTH_SECRET=replace-with-random-local-secret

RSVP_ADMIN_PASSWORD=replace-with-local-admin-password
RSVP_ADMIN_SECRET=replace-with-random-local-admin-secret

RSVP_NOTIFICATION_TO=manfrediandgabriela@gmail.com
RSVP_NOTIFICATION_FROM=rsvp@example.test
RSVP_NOTIFICATION_MODE=mock

# Required only when testing real Cloudflare Email Sending.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_EMAIL_API_TOKEN=replace-with-cloudflare-email-token
