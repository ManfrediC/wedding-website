---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { defaultLang, type Lang } from '../data/locales';
import { wedding } from '../data/site';
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/montserrat/latin-400.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-700.css';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  lang?: Lang;
  currentPath?: string;
  hideChrome?: boolean;
  languagePaths?: Record<Lang, string>;
  showLogout?: boolean;
};

const {
  title = wedding.metadataTitle,
  description = wedding.metadataDescription,
  lang = defaultLang,
  currentPath = '/',
  hideChrome = false,
  languagePaths,
  showLogout = true,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class={hideChrome ? 'plain-page' : undefined}>
    {!hideChrome && (
      <SiteHeader
        lang={lang}
        currentPath={currentPath}
        languagePaths={languagePaths}
        showLogout={showLogout}
      />
    )}
    <main id="main-content">
      <slot />
    </main>
    {!hideChrome && (
      <SiteFooter lang={lang} currentPath={currentPath} languagePaths={languagePaths} />
    )}
  </body>
</html>
