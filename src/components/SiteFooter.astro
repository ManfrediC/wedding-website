---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { type Lang } from '../data/locales';
import { wedding } from '../data/site';

type Props = {
  lang: Lang;
  currentPath?: string;
  languagePaths?: Record<Lang, string>;
};

const { lang, currentPath = '/', languagePaths } = Astro.props;
const copy = {
  en: {
    heading: 'Guest information',
    privacy: 'For invited guests only. Please do not share the link or password publicly.',
    credits: 'Image credits',
  },
  it: {
    heading: 'Informazioni per gli ospiti',
    privacy: 'Riservato agli ospiti invitati. Vi preghiamo di non condividere pubblicamente il link o la password.',
    credits: 'Crediti immagini',
  },
  de: {
    heading: 'Informationen für Gäste',
    privacy: 'Nur für eingeladene Gäste. Bitte teilt den Link oder das Passwort nicht öffentlich.',
    credits: 'Bildnachweise',
  },
}[lang];
---

<footer class="site-footer">
  <div>
    <p class="footer-monogram">{wedding.couple.monogram}</p>
    <p>{wedding.dateDisplay[lang]}</p>
    <p>{wedding.location[lang]}</p>
  </div>
  <div>
    <p class="footer-heading">{copy.heading}</p>
    <p>{copy.privacy}</p>
    <p><a class="footer-link" href={`/${lang}/credits/`}>{copy.credits}</a></p>
  </div>
  <LanguageSwitcher lang={lang} path={currentPath} paths={languagePaths} />
</footer>
