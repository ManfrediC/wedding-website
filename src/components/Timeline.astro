---
import type { Lang } from '../data/locales';
import type { ScheduleEntry } from '../data/schedule';

type Props = {
  lang: Lang;
  entries: ScheduleEntry[];
};

const { lang, entries } = Astro.props;
---

<ol class="timeline">
  {entries.map((entry) => (
    <li>
      <div class="timeline-meta">
        <div class="timeline-date">{entry.date[lang]}</div>
        <div class="timeline-time">{entry.time[lang]}</div>
      </div>
      <div class="timeline-marker" aria-hidden="true"></div>
      <div class="timeline-content">
        <p class="eyebrow">{entry.status[lang]}</p>
        <h2>{entry.title[lang]}</h2>
        <p class="timeline-location">{entry.location[lang]}</p>
        <p>{entry.body[lang]}</p>
      </div>
    </li>
  ))}
</ol>
