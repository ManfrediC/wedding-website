---
import { rsvpCopy } from '../data/rsvp';
import type { Lang } from '../data/locales';

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const copy = rsvpCopy[lang];
const dietaryOptions = [
  { value: 'None', label: copy.dietaryRequirements.options.none },
  { value: 'Vegetarian', label: copy.dietaryRequirements.options.vegetarian },
  { value: 'Vegan', label: copy.dietaryRequirements.options.vegan },
  { value: 'other', label: copy.dietaryRequirements.options.other },
];
const phoneCountryOptions = [
  { value: '', label: 'Code' },
  { value: '+41', label: 'CH +41' },
  { value: '+39', label: 'IT +39' },
  { value: '+44', label: 'UK +44' },
  { value: '+1', label: 'US/CA +1' },
  { value: '+49', label: 'DE +49' },
  { value: '+33', label: 'FR +33' },
  { value: '+34', label: 'ES +34' },
  { value: '+43', label: 'AT +43' },
];
---

<section class="content-band narrow rsvp-form-band">
  <form class="rsvp-form" action="/api/rsvp" method="post" data-rsvp-form>
    <input type="hidden" name="language" value={lang} />
    <div class="rsvp-honeypot" aria-hidden="true">
      <label>
        Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="rsvp-form-heading">
      <p>{copy.privacy}</p>
      <ul class="rsvp-update-list" aria-label={copy.updatesLabel}>
        {copy.updates.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <fieldset class="rsvp-fieldset rsvp-choice-fieldset">
      <legend>{copy.attendingLegend}</legend>
      <div class="rsvp-choice-grid">
        <label class="rsvp-radio">
          <input type="radio" name="attending" value="yes" required />
          <span>{copy.attendingYes}</span>
        </label>
        <label class="rsvp-radio">
          <input type="radio" name="attending" value="no" required />
          <span>{copy.attendingNo}</span>
        </label>
      </div>
    </fieldset>

    <div class="rsvp-field-grid">
      <label class="rsvp-field">
        <span>{copy.primaryGuestName.label}</span>
        <input type="text" name="primary_guest_name" autocomplete="name" required maxlength="120" />
      </label>
      <label class="rsvp-field">
        <span>{copy.email.label}</span>
        <input type="email" name="email" autocomplete="email" required maxlength="254" />
      </label>
      <div class="rsvp-field rsvp-phone-field">
        <span>{copy.phoneNumber.label}</span>
        <div class="rsvp-phone-inputs">
          <label>
            <span class="sr-only">{copy.phoneCountryCode.label}</span>
            <select name="phone_country_code" autocomplete="tel-country-code">
              {phoneCountryOptions.map((option) => <option value={option.value}>{option.label}</option>)}
            </select>
          </label>
          <label>
            <span class="sr-only">{copy.phoneNumber.label}</span>
            <input type="tel" name="phone_number" autocomplete="tel-national" required maxlength="80" />
          </label>
        </div>
        {copy.phoneNumber.help && <small>{copy.phoneNumber.help}</small>}
      </div>
    </div>

    <label class="rsvp-field">
      <span>{copy.address.label}</span>
      <textarea name="address" rows="3" autocomplete="street-address" maxlength="1200"></textarea>
      {copy.address.help && <small>{copy.address.help}</small>}
    </label>

    <fieldset class="rsvp-fieldset rsvp-guests-fieldset">
      <legend>{copy.guests.label}</legend>
      {copy.guests.help && <p class="small-note">{copy.guests.help}</p>}
      <div class="rsvp-guest-sections">
        <div class="rsvp-repeat-block" data-repeat-group="adult">
          <p class="rsvp-repeat-heading">{copy.adults.label}</p>
          {copy.adults.help && <p class="small-note">{copy.adults.help}</p>}
          <div class="repeat-list" data-repeat-list>
            <div class="repeat-row guest-row adult-row">
              <label class="rsvp-field guest-name-field">
                <span>{copy.adultName}</span>
                <input type="text" name="adult_name" maxlength="120" />
              </label>
              <label class="rsvp-field guest-dietary-field">
                <span>{copy.dietaryRequirements.label}</span>
                <select name="adult_dietary_requirements" data-dietary-select>
                  {dietaryOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                </select>
              </label>
              <label class="rsvp-field guest-dietary-other-field" data-dietary-other-field hidden>
                <span>{copy.dietaryRequirements.otherLabel}</span>
                <input type="text" name="adult_dietary_requirements_other" maxlength="1200" data-dietary-other />
              </label>
              <label class="rsvp-field guest-allergies-field">
                <span>{copy.allergies.label}</span>
                <input type="text" name="adult_allergies" maxlength="1200" />
              </label>
            </div>
          </div>
          <button class="button secondary repeat-add" type="button" data-repeat-add>{copy.addAdult}</button>
        </div>

        <div class="rsvp-repeat-block" data-repeat-group="child">
          <p class="rsvp-repeat-heading">{copy.children.label}</p>
          {copy.children.help && <p class="small-note">{copy.children.help}</p>}
          <div class="repeat-list" data-repeat-list>
            <div class="repeat-row guest-row child-row">
              <label class="rsvp-field">
                <span>{copy.childName}</span>
                <input type="text" name="child_name" maxlength="120" />
              </label>
              <label class="rsvp-field child-age-field">
                <span>{copy.childAge}</span>
                <input type="number" name="child_age" min="0" max="17" inputmode="numeric" />
              </label>
              <label class="rsvp-field guest-dietary-field">
                <span>{copy.dietaryRequirements.label}</span>
                <select name="child_dietary_requirements" data-dietary-select>
                  {dietaryOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                </select>
              </label>
              <label class="rsvp-field guest-dietary-other-field" data-dietary-other-field hidden>
                <span>{copy.dietaryRequirements.otherLabel}</span>
                <input type="text" name="child_dietary_requirements_other" maxlength="1200" data-dietary-other />
              </label>
              <label class="rsvp-field guest-allergies-field">
                <span>{copy.allergies.label}</span>
                <input type="text" name="child_allergies" maxlength="1200" />
              </label>
            </div>
          </div>
          <button class="button secondary repeat-add" type="button" data-repeat-add>{copy.addChild}</button>
        </div>
      </div>
    </fieldset>

    <label class="rsvp-field">
      <span>{copy.accessibilityMobility.label}</span>
      <textarea name="accessibility_mobility" rows="4" maxlength="1200"></textarea>
    </label>

    <label class="rsvp-field">
      <span>{copy.notes.label}</span>
      <textarea name="notes" rows="5" maxlength="1200"></textarea>
      {copy.notes.help && <small>{copy.notes.help}</small>}
    </label>

    <div class="rsvp-submit-row">
      <button type="submit" data-submit-label={copy.submit} data-sending-label={copy.sending}>{copy.submit}</button>
      <p class="form-error" data-rsvp-status hidden></p>
    </div>
  </form>
</section>

<script is:inline define:vars={{ messages: { success: copy.success, error: copy.error } }}>
  const form = document.querySelector('[data-rsvp-form]');

  if (form instanceof HTMLFormElement) {
    const status = form.querySelector('[data-rsvp-status]');
    const submitButton = form.querySelector('button[type="submit"]');
    const attendingInputs = form.querySelectorAll('input[name="attending"]');
    const adultInputs = () => form.querySelectorAll('input[name="adult_name"]');
    const dietarySelects = () => form.querySelectorAll('[data-dietary-select]');

    const setStatus = (message, success = false) => {
      if (!(status instanceof HTMLElement)) {
        return;
      }

      status.hidden = false;
      status.textContent = message;
      status.classList.toggle('form-success', success);
    };

    const clearStatus = () => {
      if (status instanceof HTMLElement) {
        status.hidden = true;
        status.textContent = '';
        status.classList.remove('form-success');
      }
    };

    const syncAttendanceFields = () => {
      const isAttending = form.querySelector('input[name="attending"]:checked')?.value === 'yes';
      adultInputs().forEach((input, index) => {
        input.required = isAttending && index === 0;
      });
    };

    const syncDietaryField = (select) => {
      if (!(select instanceof HTMLSelectElement)) {
        return;
      }

      const scope = select.closest('.repeat-row') ?? form;
      const dietaryOtherField = scope.querySelector('[data-dietary-other-field]');
      const dietaryOtherInput = scope.querySelector('[data-dietary-other]');
      const showOther = select.value === 'other';
      dietaryOtherField?.toggleAttribute('hidden', !showOther);

      if (dietaryOtherInput instanceof HTMLInputElement) {
        dietaryOtherInput.required = showOther;
        if (!showOther) {
          dietaryOtherInput.value = '';
        }
      }
    };

    const syncDietaryFields = () => {
      dietarySelects().forEach(syncDietaryField);
    };

    form.querySelectorAll('[data-repeat-group]').forEach((group) => {
      const list = group.querySelector('[data-repeat-list]');
      const button = group.querySelector('[data-repeat-add]');

      if (!(list instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) {
        return;
      }

      button.addEventListener('click', () => {
        const row = list.querySelector('.repeat-row');
        if (!(row instanceof HTMLElement)) {
          return;
        }

        const clone = row.cloneNode(true);
        if (!(clone instanceof HTMLElement)) {
          return;
        }

        clone.querySelectorAll('input').forEach((input) => {
          input.value = '';
        });
        clone.querySelectorAll('textarea').forEach((textarea) => {
          textarea.value = '';
        });
        clone.querySelectorAll('select').forEach((select) => {
          select.selectedIndex = 0;
        });
        list.append(clone);
        syncAttendanceFields();
        syncDietaryFields();
        clone.querySelector('input')?.focus();
      });
    });

    attendingInputs.forEach((input) => {
      input.addEventListener('change', syncAttendanceFields);
    });
    form.addEventListener('change', (event) => {
      if (event.target instanceof HTMLSelectElement && event.target.matches('[data-dietary-select]')) {
        syncDietaryField(event.target);
      }
    });
    syncAttendanceFields();
    syncDietaryFields();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearStatus();

      if (!(submitButton instanceof HTMLButtonElement)) {
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = submitButton.dataset.sendingLabel ?? submitButton.textContent;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const body = await response.json().catch(() => undefined);

        if (!response.ok || !body?.ok) {
          setStatus(messages.error);
          return;
        }

        form.reset();
        syncAttendanceFields();
        syncDietaryFields();
        setStatus(messages.success, true);
      } catch {
        setStatus(messages.error);
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = submitButton.dataset.submitLabel ?? submitButton.textContent;
      }
    });
  }
</script>
