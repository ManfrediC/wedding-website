---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { navItems, type Lang } from '../data/locales';
import { wedding } from '../data/site';

type Props = {
  lang: Lang;
  currentPath?: string;
  languagePaths?: Record<Lang, string>;
  showLogout?: boolean;
};

const {
  lang,
  currentPath = '/',
  languagePaths,
  showLogout = true,
} = Astro.props;

const mobileLanguageLabels: Record<Lang, string> = {
  en: 'Language',
  it: 'Lingua',
  de: 'Sprache',
};

const logoutLabels: Record<Lang, string> = {
  en: 'Log out',
  it: 'Esci',
  de: 'Abmelden',
};

const logoutNext = `/${lang}${currentPath}`;
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <a class="monogram" href={`/${lang}/`} aria-label="Gabriela and Manfredi home">
    {wedding.couple.monogram}
  </a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    {navItems.map((item) => (
      <a
        href={`/${lang}${item.path}`}
        aria-current={currentPath === item.path ? 'page' : undefined}
      >
        {item.labels[lang]}
      </a>
    ))}
  </nav>

  <div class="header-actions">
    <div class="header-language">
      <LanguageSwitcher lang={lang} path={currentPath} paths={languagePaths} />
    </div>
    {showLogout && (
      <form class="logout-form" action="/logout/" method="post">
        <input type="hidden" name="next" value={logoutNext} />
        <button class="logout-button" type="submit">{logoutLabels[lang]}</button>
      </form>
    )}
  </div>

  <div class="mobile-header-controls">
    <details class="mobile-disclosure mobile-language-menu" name="mobile-header-disclosure" data-mobile-header-disclosure>
      <summary>{mobileLanguageLabels[lang]}</summary>
      <LanguageSwitcher lang={lang} path={currentPath} paths={languagePaths} />
    </details>

    <details class="mobile-disclosure mobile-menu" name="mobile-header-disclosure" data-mobile-header-disclosure>
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        {navItems.map((item) => (
          <a
            href={`/${lang}${item.path}`}
            aria-current={currentPath === item.path ? 'page' : undefined}
          >
            {item.labels[lang]}
          </a>
        ))}
      </nav>
    </details>

    {showLogout && (
      <form class="logout-form mobile-logout-form" action="/logout/" method="post">
        <input type="hidden" name="next" value={logoutNext} />
        <button class="logout-button" type="submit">{logoutLabels[lang]}</button>
      </form>
    )}
  </div>
</header>

<script is:inline>
  (() => {
    const mobileHeaderDisclosures = document.querySelectorAll('[data-mobile-header-disclosure]');

    const closeOtherMobileHeaderDisclosures = (activeDisclosure) => {
      mobileHeaderDisclosures.forEach((disclosure) => {
        if (disclosure !== activeDisclosure) {
          disclosure.removeAttribute('open');
        }
      });
    };

    mobileHeaderDisclosures.forEach((disclosure) => {
      disclosure.querySelector('summary')?.addEventListener('click', () => {
        closeOtherMobileHeaderDisclosures(disclosure);
      });

      disclosure.addEventListener('toggle', () => {
        if (!disclosure.open) {
          return;
        }

        closeOtherMobileHeaderDisclosures(disclosure);
      });
    });
  })();
</script>
