---
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/montserrat/latin-400.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-700.css';
---

<section class="welcome-page" aria-labelledby="welcome-title">
  <div class="welcome-border" aria-hidden="true">
    <img class="welcome-frame" src="/images/landing/frame.svg" alt="" />
    <span class="welcome-frame-ornament">
      <img src="/images/landing/ornament.svg" alt="" />
    </span>
  </div>
  <div class="welcome-shell">
    <h1 id="welcome-title">
      <span>Gabriela</span>
      <span class="welcome-ampersand">&amp;</span>
      <span>Manfredi</span>
    </h1>
    <div class="welcome-rule" aria-hidden="true"></div>
    <p class="welcome-date">11 June 2027</p>

    <form class="welcome-panel" method="post" action="/welcome/" data-welcome-form>
      <input type="hidden" name="next" value="/en/" data-next-input />
      <div class="panel-ornament panel-ornament-top" aria-hidden="true">
        <img src="/images/landing/ornament.svg" alt="" />
      </div>
      <p data-welcome-text="prompt">Please enter the password from your invitation.</p>
      <label class="sr-only" for="password" data-welcome-text="label">Wedding password</label>
      <div class="password-field">
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          placeholder="Password"
          data-password-input
          required
        />
        <span class="password-lock" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <rect x="6.75" y="10" width="10.5" height="9.25" rx="1.4"></rect>
            <path d="M8.8 10V7.6a3.2 3.2 0 0 1 6.4 0V10"></path>
            <path d="M12 13.75v2"></path>
          </svg>
        </span>
      </div>
      <p class="form-error" data-error-message data-welcome-text="error" hidden>
        The password was not recognised. Please check the invitation and try again.
      </p>
      <button type="submit" data-welcome-text="button">Enter</button>
      <div class="panel-ornament panel-ornament-bottom" aria-hidden="true">
        <img src="/images/landing/ornament.svg" alt="" />
      </div>
    </form>

    <nav class="welcome-language-links" aria-label="Choose destination language after entering the password">
      <a href="/welcome/?next=/en/" data-language-link="en">English</a>
      <span aria-hidden="true">|</span>
      <a href="/welcome/?next=/it/" data-language-link="it">Italiano</a>
      <span aria-hidden="true">|</span>
      <a href="/welcome/?next=/de/" data-language-link="de">Deutsch</a>
    </nav>
  </div>
</section>

<script is:inline>
  const welcomeCopy = {
    en: {
      prompt: 'Please enter the password from your invitation.',
      label: 'Wedding password',
      placeholder: 'Password',
      error: 'The password was not recognised. Please check the invitation and try again.',
      button: 'Enter',
    },
    it: {
      prompt: 'Inserite la password indicata nel vostro invito.',
      label: 'Password del matrimonio',
      placeholder: 'Password',
      error: "La password non è stata riconosciuta. Controllate l'invito e riprovate.",
      button: 'Entra',
    },
    de: {
      prompt: 'Bitte gebt das Passwort aus eurer Einladung ein.',
      label: 'Hochzeitspasswort',
      placeholder: 'Passwort',
      error: 'Das Passwort wurde nicht erkannt. Bitte prüft die Einladung und versucht es erneut.',
      button: 'Öffnen',
    },
  };
  const welcomeLanguages = Object.keys(welcomeCopy);
  const params = new URLSearchParams(window.location.search);
  const next = params.get('next');
  const nextPath = next ? next.split('?')[0] : '';
  const safeNext =
    next &&
    next.startsWith('/') &&
    !next.startsWith('//') &&
    nextPath !== '/' &&
    nextPath !== '/welcome' &&
    nextPath !== '/welcome/' &&
    nextPath !== '/login' &&
    nextPath !== '/login/'
      ? next
      : '/en/';
  const languageMatch = safeNext.match(/^\/(en|it|de)(\/.*)?$/);
  const activeLanguage = languageMatch ? languageMatch[1] : 'en';
  const pathAfterLanguage = languageMatch ? (languageMatch[2] ?? '/') : '/';
  const nextInput = document.querySelector('[data-next-input]');
  const errorMessage = document.querySelector('[data-error-message]');
  const passwordInput = document.querySelector('[data-password-input]');

  if (nextInput) {
    nextInput.value = safeNext;
  }

  document.documentElement.lang = activeLanguage;

  document.querySelectorAll('[data-welcome-text]').forEach((element) => {
    const key = element.getAttribute('data-welcome-text');
    const text = welcomeCopy[activeLanguage][key];

    if (text) {
      element.textContent = text;
    }
  });

  if (passwordInput) {
    passwordInput.setAttribute('placeholder', welcomeCopy[activeLanguage].placeholder);
  }

  welcomeLanguages.forEach((language) => {
    const link = document.querySelector(`[data-language-link="${language}"]`);
    if (!link) {
      return;
    }

    link.setAttribute('href', `/welcome/?next=/${language}${pathAfterLanguage}`);

    if (language === activeLanguage) {
      link.setAttribute('aria-current', 'page');
    } else {
      link.removeAttribute('aria-current');
    }
  });

  if (errorMessage && params.get('error') === '1') {
    errorMessage.hidden = false;
  }
</script>
