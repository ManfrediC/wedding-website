---
type Props = {
  items: { question: string; answer: string; links?: { label: string; href: string }[] }[];
};

const { items } = Astro.props;
---

<div class="faq-list">
  {items.map((item) => (
    <details>
      <summary>{item.question}</summary>
      <p>{item.answer}</p>
      {item.links && (
        <ul class="faq-links">
          {item.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      )}
    </details>
  ))}
</div>
