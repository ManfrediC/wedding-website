---
import BaseLayout from '../layouts/BaseLayout.astro';
import { wedding } from '../data/site';
---

<BaseLayout title={`Welcome | ${wedding.couple.display}`} hideChrome>
  <section class="welcome-page" style="--welcome-image: url('/images/minted/minted-hero.jpg')">
    <div class="welcome-panel">
      <p class="monogram">{wedding.couple.monogram}</p>
      <p class="eyebrow">Private wedding website</p>
      <h1>Welcome</h1>
      <p>The password page has moved to the welcome page.</p>
      <p><a class="button primary" href="/welcome/">Continue to welcome page</a></p>
    </div>
  </section>
</BaseLayout>
