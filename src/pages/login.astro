---
import BaseLayout from '../layouts/BaseLayout.astro';
import { wedding } from '../data/site';
---

<BaseLayout title={`Welcome | ${wedding.couple.display}`} hideChrome>
  <meta http-equiv="refresh" content="0; url=/welcome/" />
  <section class="welcome-page" aria-labelledby="login-title">
    <div class="welcome-border" aria-hidden="true"></div>
    <div class="welcome-shell">
      <div class="welcome-monogram" aria-label={wedding.couple.monogram}>
        <span aria-hidden="true"></span>
        <p>{wedding.couple.monogram}</p>
        <span aria-hidden="true"></span>
      </div>
      <h1 id="login-title">{wedding.couple.display}</h1>
      <p class="welcome-date">11 June 2027</p>
      <p class="welcome-redirect">
        Redirecting to the welcome page.
        <a href="/welcome/">Continue</a>
      </p>
    </div>
  </section>
</BaseLayout>
