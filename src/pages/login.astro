---
import BaseLayout from '../layouts/BaseLayout.astro';
import { wedding } from '../data/site';
---

<BaseLayout title={`Welcome | ${wedding.couple.display}`} hideChrome>
  <section class="login-page">
    <div class="login-panel">
      <p class="monogram">{wedding.couple.monogram}</p>
      <p class="eyebrow">Private wedding website</p>
      <h1>{wedding.couple.display}</h1>
      <p>Please enter the password from your invitation.</p>
      <form method="post" action="/login/">
        <label for="password">Wedding password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
        <button type="submit">Enter website</button>
      </form>
      <p class="small-note">For invited guests only. Please do not share the password publicly.</p>
    </div>
  </section>
</BaseLayout>
